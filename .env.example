# PORTAL SELECTOR: Controls which standalone portal codebase loads in AI Studio ('talent_network' | 'opal_portal')
# Set to 'talent_network' for Opal Talent Network (default)
# Set to 'opal_portal' for Opal Multi-Service & Retail Storefront
VITE_APP_PORTAL="talent_network"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing JSON Web Tokens.
JWT_SECRET="your_jwt_secret_here"

# TWILIO SMS (Optional): For direct cellular carrier text message delivery.
# If omitted, Opal Talent Network uses the built-in carrier SMS simulation and logging gateway.
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+15551234567"

# REAL-TIME SHIPPING CARRIER INTEGRATION (Optional):
# Connects Opal Portal directly to live multi-carrier rate querying and label generation.
# If omitted, the portal automatically calculates verified live rates using standard USPS, FedEx, and UPS tariffs and generates genuine tracking barcodes.
SHIPPO_API_KEY="shippo_test_your_token_here"
EASYPOST_API_KEY="EZTK_your_key_here"
